'use strict';
var population = document.querySelectorAll('.population');
var total = document.querySelector('.total-population');
var average = document.querySelector('.average-population');
var totalPopulation = 0;
var averagePopulation = 0;
for(var i = 0; i < population.length; i++){
    var populationNumber = +population[i].textContent.split(',').join('');
    totalPopulation += populationNumber;
}
averagePopulation = totalPopulation / population.length;
averagePopulation = averagePopulation.toLocaleString('en');
totalPopulation = totalPopulation.toLocaleString('en');
average.textContent = averagePopulation;
total.textContent = totalPopulation;

